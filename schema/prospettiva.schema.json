{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/prospettiva/schema/prospettiva.schema.json",
  "title": "Prospettiva",
  "description": "Formato dati di Prospettiva. Lo schema copre struttura, tipi e vocabolari chiusi; i vincoli fra campi diversi (riferimenti `who`, fine prima dell'inizio, luoghi risolvibili) sono verificati dal validatore dell'applicazione — vedi docs/requisiti.md.",
  "type": "object",
  "required": [
    "people"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "anchor": {
          "type": "string",
          "description": "Id della persona rispetto a cui calcolare i countdown."
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ageDisplay": {
          "enum": [
            "midpoint",
            "range"
          ],
          "default": "midpoint",
          "description": "Come mostrare le età derivate da date imprecise: ~77 anni oppure 76–77 anni."
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "description": "Anniversari usati dagli eventi con `recurrences: true`."
        },
        "horizon": {
          "$ref": "#/$defs/date",
          "default": "2060",
          "description": "Limite delle proiezioni future."
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          },
          "description": "Corsie accese all'apertura."
        }
      }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sharedEvent"
      },
      "description": "Eventi con `who` sono condivisi; senza `who` sono contesto (il mondo intorno)."
    },
    "periods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sharedPeriod"
      }
    },
    "holidays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sharedPeriod"
      },
      "description": "Zucchero sintattico: diventano periodi condivisi con track `holiday`."
    },
    "places": {
      "type": "object",
      "description": "Nome del luogo → [latitudine, longitudine].",
      "additionalProperties": {
        "$ref": "#/$defs/coord"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^-?\\d{1,4}(-\\d{1,2}(-\\d{1,2})?)?$",
      "description": "Precisione variabile: AAAA, AAAA-MM oppure AAAA-MM-GG. La forma canonica usa due cifre per mese e giorno.",
      "examples": [
        "1921",
        "1998-11",
        "2008-07-12"
      ]
    },
    "coord": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      ],
      "items": false,
      "description": "[latitudine, longitudine], in quest'ordine."
    },
    "track": {
      "enum": [
        "school",
        "work",
        "home",
        "holiday",
        "finance",
        "doc",
        "life",
        "world"
      ]
    },
    "category": {
      "type": "string",
      "description": "Vocabolario aperto: i valori fuori elenco finiscono nella corsia Vita e generano un avviso.",
      "examples": [
        "school",
        "work",
        "home",
        "holiday",
        "finance",
        "doc",
        "life",
        "family",
        "sport",
        "history"
      ]
    },
    "stage": {
      "enum": [
        "primary",
        "middle",
        "highschool",
        "bachelor",
        "master"
      ]
    },
    "place": {
      "description": "Una stringa risolta tramite `places` o il repertorio interno, oppure un oggetto con coordinate esplicite.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "coord": {
              "$ref": "#/$defs/coord"
            }
          }
        }
      ]
    },
    "person": {
      "type": "object",
      "required": [
        "name",
        "birth"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Necessario per essere citati in `who`."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "examples": [
            "self",
            "partner",
            "child",
            "parent",
            "grandparent",
            "sibling",
            "friend"
          ]
        },
        "birth": {
          "$ref": "#/$defs/date"
        },
        "death": {
          "$ref": "#/$defs/date"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "school": {
          "$ref": "#/$defs/school"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "periods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/period"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "school": {
      "type": "object",
      "description": "Genera i cicli scolastici dalla sola data di nascita.",
      "additionalProperties": false,
      "properties": {
        "system": {
          "enum": [
            "it"
          ],
          "default": "it"
        },
        "through": {
          "$ref": "#/$defs/stage",
          "default": "highschool"
        },
        "early": {
          "type": "boolean",
          "default": false,
          "description": "Anticipo: sposta tutti i cicli un anno indietro."
        },
        "delays": {
          "type": "object",
          "description": "Anni persi, per ciclo. Spostano in avanti tutto ciò che segue.",
          "propertyNames": {
            "$ref": "#/$defs/stage"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "document": {
      "type": "object",
      "required": [
        "expires"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "patente",
            "passaporto",
            "identita"
          ],
          "description": "Determina la cadenza dei rinnovi in base all'età al rilascio."
        },
        "expires": {
          "$ref": "#/$defs/date",
          "description": "Scadenza corrente: la catena si proietta da qui."
        },
        "validity": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Validità in anni. Ha la precedenza sulle regole di `type`."
        }
      }
    },
    "sharedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        }
      ],
      "properties": {
        "who": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Id delle persone coinvolte. Senza `who` la voce è contesto."
        }
      },
      "unevaluatedProperties": false
    },
    "sharedPeriod": {
      "allOf": [
        {
          "$ref": "#/$defs/periodBase"
        }
      ],
      "properties": {
        "who": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Id delle persone coinvolte. Senza `who` la voce è contesto."
        }
      },
      "unevaluatedProperties": false
    },
    "eventBase": {
      "type": "object",
      "required": [
        "date"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "track": {
          "$ref": "#/$defs/track"
        },
        "place": {
          "$ref": "#/$defs/place"
        },
        "circa": {
          "type": "boolean",
          "description": "Ricordo incerto. Diverso dalla precisione della data."
        },
        "note": {
          "type": "string"
        },
        "recurrences": {
          "description": "Anniversari da segnare. `true` usa settings.milestones.",
          "oneOf": [
            {
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            }
          ]
        }
      },
      "description": "Base condivisa. Le forme concrete sono `event` e `sharedEvent`."
    },
    "periodBase": {
      "type": "object",
      "required": [
        "start"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date",
          "description": "Assente significa «ancora in corso»."
        },
        "track": {
          "$ref": "#/$defs/track"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "place": {
          "$ref": "#/$defs/place"
        },
        "circa": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "replaces": {
          "$ref": "#/$defs/stage",
          "description": "Sostituisce il ciclo generato da `school`. Ha effetto solo se la persona ha un blocco `school`."
        }
      },
      "description": "Base condivisa. Le forme concrete sono `period` e `sharedPeriod`."
    },
    "event": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        }
      ],
      "unevaluatedProperties": false
    },
    "period": {
      "allOf": [
        {
          "$ref": "#/$defs/periodBase"
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
